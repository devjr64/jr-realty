# =============================================================================
# JR Realty — Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in your real values.
# NEVER commit `.env` to version control (see .gitignore).
#
# Production: runs natively on VPS (Node.js 24 + PostgreSQL 16 + pm2).
# Development: Docker provides PostgreSQL only (see docker-compose.yml).
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# NOTE: Password must be URL-safe (letters + numbers only). Characters like
# / + = @ : ? # break the connection string. Use: openssl rand -hex 24
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/jrrealty?schema=public"

# -----------------------------------------------------------------------------
# Seed
# -----------------------------------------------------------------------------
# Set to 'false' in production to skip all demo content (agents, properties,
# projects, testimonials, blog posts, CMS page). Only super admin, zones and
# base site settings will be created.
SEED_DEMO_DATA="true"

# -----------------------------------------------------------------------------
# Auth (NextAuth.js v5)
# -----------------------------------------------------------------------------
# Generate with: npx auth secret  (32+ chars random)
AUTH_SECRET=""
# AUTH_URL is optional in dev — NextAuth infers it from the request host.
# If set, it MUST match the port you run on. With pinned dev port 3000 the
# default below works; when using `pnpm dev:3001`, either unset AUTH_URL
# or set it to http://localhost:3001. Without it, auth cookies bind to the
# request origin automatically (no mismatch).
AUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# App URL (public base URL)
# -----------------------------------------------------------------------------
# Public canonical URL used in metadata, og tags, and absolute links.
# In dev it should match your dev port (3000 pinned, 3001 fallback).
# Prefer deriving from request headers over this var when possible.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="JR Realty <noreply@jrrealty.com>"

# -----------------------------------------------------------------------------
# Google Maps (Phase 2)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# -----------------------------------------------------------------------------
# File storage (Cloudflare R2 / Uploadthing — Phase 2)
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
UPLOADTHING_TOKEN=""

# -----------------------------------------------------------------------------
# Rate limiting (Upstash Redis — optional Phase 2)
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# -----------------------------------------------------------------------------
# MCP Server (Model Context Protocol)
# -----------------------------------------------------------------------------
# Enable MCP server for AI agent integration
MCP_ENABLED="true"
# Generate with: pnpm exec tsx scripts/generate-mcp-key.ts <environment> <user_email>
MCP_API_KEY=""
# MCP server URL (for stdio transport)
MCP_SERVER_URL="http://localhost:3000/api/mcp"
